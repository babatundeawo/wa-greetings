rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Which contacts have been greeted. Signed-in users only.
    // This app has no sign-up page; the one account is created in the
    // Firebase Console, and public sign-up is switched off there too
    // (see docs/FIREBASE_LOGIN_SETUP.md).
    match /rotation/{document=**} {
      allow read, write: if request.auth != null;
    }

    // The contact list, split into documents (part-001, part-002, ...).
    // Signed-in users only. Nothing here is ever served as a public file.
    match /contactBook/{part} {
      allow read, write: if request.auth != null;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
