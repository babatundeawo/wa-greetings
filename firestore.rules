rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only a signed-in Firebase user may read or write the rotation data.
    // There is no public sign-up for this app — the single allowed account
    // is created manually in Firebase Console → Authentication → Users.
    match /rotation/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
