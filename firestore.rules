rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.uid == 'ASOjQ5C0tBYSO1FciYRhT8KFqvB2';
    }

    match /rotation/state {
      allow read: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.sentPhones is list
        && request.resource.data.sentPhones.size() <= 20000;
      allow delete: if false;
    }

    match /contactBook/{part} {
      allow read: if isOwner();
      allow create, update: if isOwner()
        && part.matches('part-[0-9]{3}')
        && request.resource.data.keys().hasOnly(['index', 'list', 'updatedAt'])
        && request.resource.data.index is int
        && request.resource.data.list is list
        && request.resource.data.list.size() <= 1000
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}