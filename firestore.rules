rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Open access, but scoped to ONLY the rotation state/batches —
    // nothing else in this database is reachable, even if you add more
    // collections later without updating these rules.
    match /rotation/{document=**} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
